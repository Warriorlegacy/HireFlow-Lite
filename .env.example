# HireFlow Lite — environment placeholders only. Never commit real secrets.

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Worker runtime vars (configured in wrangler.jsonc)
ENVIRONMENT=production
APP_URL=https://hireflow-lite.example.workers.dev
ALLOW_DEMO=true
DEMO_SECRET=

# Optional email provider (adapter present, disabled until configured)
RESEND_API_KEY=
EMAIL_FROM=Hiring team <hiring@example.com>

# Optional AI helper (off by default; requires explicit admin opt-in)
AI_ENABLED=false
GEMINI_API_KEY=
